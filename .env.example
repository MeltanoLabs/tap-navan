# Navan API Configuration (TMC bookings + Expense)
# Copy this file to .env and fill in your actual values.
# Credentials are issued per company by Navan — generate them in the
# Navan Admin Dashboard under Settings > Integrations. The same OAuth
# client credentials cover both the TMC booking endpoints and the
# Expense paginatedReports endpoints; the granted scopes determine
# which streams will return data.

# Required: OAuth2 client ID
TAP_NAVAN_CLIENT_ID=your_client_id_here

# Required: OAuth2 client secret (decrypt the RSA-encrypted value Navan
# provides before setting this — see the TMC integration docs for the
# openssl command).
TAP_NAVAN_CLIENT_SECRET=your_decrypted_client_secret_here

# Optional: Earliest date to sync (ISO 8601).
# - For the bookings stream: bookings created before this date are ignored.
# - For the expense streams (card_transactions, connect_transactions,
#   manual_transactions, repayments, fees, adjustments, daily_rebates,
#   disputes): the tap walks 93-day date_modified windows from this date
#   forward when no prior state bookmark exists. The Expense Partner API
#   only accepts dates on or after the first day of the month two months
#   prior to today, so values older than that are silently clamped.
TAP_NAVAN_START_DATE=2024-01-01T00:00:00Z

# Optional: API base URL.
#   Production US (default): https://api.navan.com
#   Production EU:           https://app-fra.navan.com
#   Staging:                 https://staging-prime.tripactions.com
TAP_NAVAN_API_URL=https://api.navan.com
